{
  "name": "telligen-automation",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "test":              "npx playwright test",
    "test:chromium":     "npx playwright test --project=chromium",
    "test:firefox":      "npx playwright test --project=firefox",
    "test:webkit":       "npx playwright test --project=webkit",
    "test:mobile":       "npx playwright test --project=mobile-chrome --project=mobile-safari",
    "test:tablet":       "npx playwright test --project=tablet",
    "test:api":          "npx playwright test --project=api",
    "test:all-browsers": "npx playwright test --project=chromium --project=firefox --project=webkit",
    "test:smoke":        "npx playwright test --grep @smoke",
    "test:regression":   "npx playwright test --grep @regression",
    "test:accessibility":"npx playwright test --grep @accessibility",
    "test:performance":  "npx playwright test --grep @performance",
    "test:headed":       "npx playwright test --headed",
    "test:debug":        "npx playwright test --debug",
    "test:ui":           "npx playwright test --ui",
    "report:html":       "npx playwright show-report",
    "report:allure":     "allure serve allure-results",
    "report:generate":   "allure generate allure-results --clean -o allure-report",
    "clean":             "rm -rf test-results playwright-report allure-results allure-report screenshots",
    "test:telligen":        "npx playwright test tests/telligen/ --project=chromium",
    "test:telligen:smoke":  "npx playwright test tests/telligen/smoke/ --project=chromium",
    "test:telligen:nav":    "npx playwright test tests/telligen/navigation/ --project=chromium",
    "test:telligen:a11y":   "npx playwright test tests/telligen/accessibility/ --project=chromium",
    "test:telligen:perf":   "npx playwright test tests/telligen/performance/ --project=chromium",
    "test:telligen:mobile": "npx playwright test tests/telligen/ --project=telligen-mobile"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^26.4.1",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.12.0",
    "dotenv": "^17.4.2",
    "typescript": "^7.0.2"
  }
}
