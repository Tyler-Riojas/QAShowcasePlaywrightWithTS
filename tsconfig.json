{
  "compilerOptions": {
    "strict": true,
    "target": "ES2020",
    "lib": ["ES2020", "ESNext", "DOM"],
    "module": "commonjs",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@fixtures/*": ["./fixtures/*"],
      "@core/*": ["./core/*"],
      "@pages/*": ["./pages/*"],
      "@utils/*": ["./utils/*"],
      "@helpers/*": ["./helpers/*"]
    },
    "types": ["node"]
  }
}
